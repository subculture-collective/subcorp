# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://subcorp:replace-me@postgres:5432/subcorp_ops
POSTGRES_PASSWORD=replace-me

# ─── Brave Search (Web Search Tool) ────────────────────────────────
BRAVE_API_KEY=

# ─── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://subcorp.subcult.tv
NEXT_PUBLIC_SANCTUM_WS_PORT=3002
CRON_SECRET=replace-me
DASHBOARD_SECRET=replace-me
SUBCORP_BIND_IP=127.0.0.1
COMPOSE_PROJECT_NAME=subcorp

# ─── llama-line/Ollama ─────────────────────────────────────────────
# Broker handles all inference. openai/* routes go to OpenCode; tool calls use OLLAMA_TOOL_MODEL.
# OLLAMA_TOOL_MODEL must be a local Ollama model that emits native tool_calls.
OLLAMA_BASE_URL=http://10.0.0.50:11434
OLLAMA_API_KEY=replace-me
OLLAMA_ENABLED=true
OLLAMA_MODEL=openai/gpt-5.5
OLLAMA_TOOL_MODEL=qwen3:14b

# ─── Embeddings ────────────────────────────────────────────────────
# Best-effort embeddings should not starve worker mission dispatch.
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_OLLAMA_URL=http://10.0.0.50:11434
EMBEDDING_OLLAMA_API_KEY=replace-me
EMBEDDING_TIMEOUT_MS=120000

# ─── Gitea Agent Push Access ───────────────────────────────────────
# GITHUB_TOKEN is only a legacy fallback; prefer GITEA_TOKEN.
GITEA_BASE_URL=https://git.subcult.tv
GITEA_ORG=subculture-collective
GITEA_USERNAME=x-access-token
GITEA_TOKEN=
GITEA_WORKSPACE_REPO=subcorp-workspace
GITEA_WORKSPACE_PRIVATE=true
GITEA_PROJECT_PRIVATE=false

# ─── Discord ───────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=replace-me

# ─── Discord Channels ──────────────────────────────────────────────
# Auto-synced to ops_discord_channels on startup.
# Underscores in name become hyphens: DAILY_DIGEST → daily-digest.
DISCORD_CHANNEL_ROUNDTABLE=
DISCORD_CHANNEL_BRAINSTORM=
DISCORD_CHANNEL_DRAFTS=
DISCORD_CHANNEL_MISSIONS=
DISCORD_CHANNEL_SYSTEM_LOG=
DISCORD_CHANNEL_RESEARCH=
DISCORD_CHANNEL_INSIGHTS=
DISCORD_CHANNEL_PROPOSALS=
DISCORD_CHANNEL_PROJECT=
DISCORD_CHANNEL_WATERCOOLER=
DISCORD_CHANNEL_DAILY_DIGEST=
DISCORD_CHANNEL_NEWS_DIGEST=
DISCORD_CHANNEL_SANCTUM_CHAT=
DISCORD_CHANNEL_DREAMS=
DISCORD_CHANNEL_VOICE_GENERAL=
DISCORD_CHANNEL_NEWSLETTER=

# ─── OAuth / External Integrations ─────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_REDIRECT_BASE_URL=https://subcorp.subcult.tv
OPENAI_CLIENT_ID=

# ─── Model Routing ─────────────────────────────────────────────────
# Env is the editable source of truth. Keep one default, then add only contexts that need a different model.
# Double underscore (__) becomes colon (:), e.g. ROUNDTABLE__DEEP_DIVE.
MODEL_ROUTING_ENABLED=true
MODEL_ROUTING_DEFAULT=openai/gpt-5.5
MODEL_ROUTING_AGENT_SESSION=openai/gpt-5.5
MODEL_ROUTING_AGENT_SPAWN=openai/gpt-5.5
MODEL_ROUTING_ROUNDTABLE=openai/gpt-5.5
MODEL_ROUTING_ROUNDTABLE__DEEP_DIVE=qwen3:14b
MODEL_ROUTING_CONTENT_REVIEW=qwen3:14b

# ─── Ghost Publishing ──────────────────────────────────────────────
GHOST_ADMIN_API_KEY=

# ─── ElevenLabs TTS ────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty
NODE_ENV=production

# ─── Admin User (for seed script) ──────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# ─── Ops / Droid / Docker ──────────────────────────────────────────
DAILY_PROPOSAL_LIMIT=100
MAX_DROID_TIMEOUT_SECONDS=3600
DEFAULT_DROID_TIMEOUT_SECONDS=1200
DOCKER_SOCK=/var/run/docker.sock
DOCKER_SOCK_GID=998
